// db-adapter.ts
//
// Generic player-store interface with two backends:
//   - IndexedDBAdapter: runs inside the Puppeteer page via page.evaluate()
//   - MongoAdapter: plain Node.js mongodb driver
//
// Both implement the same PlayerStore interface, so the rest of your bot
// (util.dbUtil.*) doesn't need to know which backend is active.

import type { Page } from "puppeteer";
import { MongoClient, Collection } from "mongodb";

export interface Player {
  authKey: string;
  name: string;
  elo: number;
  lastActivity: number; // epoch ms
}

export interface PlayerStore {
  getPlayer(authKey: string): Promise<Player | null>;
  getPlayerByName(name: string): Promise<Player | null>;
  createOrUpdatePlayer(player: Player): Promise<void>;
  batchUpdatePlayers(players: Player[]): Promise<void>;
  getTopEloPlayers(limit: number): Promise<Player[]>;
  getOldestPlayers(limit: number): Promise<Player[]>;
  getTotalPlayers(): Promise<number>;
  removeInactivePlayers(olderThanMs: number): Promise<number>; // returns count removed
}

// ---------------------------------------------------------------------------
// IndexedDB adapter — everything runs INSIDE the browser page context.
// The functions passed to page.evaluate must be fully self-contained
// (no closures over outer variables except what you pass in as args).
// ---------------------------------------------------------------------------

export class IndexedDBAdapter implements PlayerStore {
  constructor(private page: Page, private dbName = "haxballDB", private storeName = "players") { }

  private async withStore<T>(mode: IDBTransactionMode, fn: string, args: any[]): Promise<T> {
    return this.page.evaluate(
      ({ dbName, storeName, mode, fn, args }) => {
        return new Promise<any>((resolve, reject) => {
          const req = indexedDB.open(dbName);
          req.onerror = () => reject(req.error);
          req.onsuccess = () => {
            const db = req.result;
            const tx = db.transaction(storeName, mode);
            const store = tx.objectStore(storeName);

            // Minimal in-page dispatch table so we don't need to serialize functions.
            const ops: Record<string, () => IDBRequest | void> = {
              get: () => store.get(args[0]),
              put: () => store.put(args[0]),
              getAll: () => store.getAll(),
              delete: () => store.delete(args[0]),
            };

            const opReq = ops[fn]?.();
            if (!opReq) return resolve(undefined);
            (opReq as IDBRequest).onsuccess = () => resolve((opReq as IDBRequest).result);
            (opReq as IDBRequest).onerror = () => reject((opReq as IDBRequest).error);
          };
        });
      },
      { dbName, storeName: this.storeName, mode, fn, args }
    );
  }

  async getPlayer(authKey: string): Promise<Player | null> {
    const result = await this.withStore<Player | undefined>("readonly", "get", [authKey]);
    return result ?? null;
  }

  async getPlayerByName(name: string): Promise<Player | null> {
    const all = await this.withStore<Player[]>("readonly", "getAll", []);
    return all.find((p) => p.name === name) ?? null;
  }

  async createOrUpdatePlayer(player: Player): Promise<void> {
    await this.withStore("readwrite", "put", [player]);
  }

  async batchUpdatePlayers(players: Player[]): Promise<void> {
    // Sequential puts inside one page.evaluate would be more efficient,
    // but keeping it simple/consistent with the single-put path for now.
    for (const player of players) {
      await this.createOrUpdatePlayer(player);
    }
  }

  async getTopEloPlayers(limit: number): Promise<Player[]> {
    const all = await this.withStore<Player[]>("readonly", "getAll", []);
    return all.sort((a, b) => b.elo - a.elo).slice(0, limit);
  }

  async getOldestPlayers(limit: number): Promise<Player[]> {
    const all = await this.withStore<Player[]>("readonly", "getAll", []);
    return all.sort((a, b) => a.lastActivity - b.lastActivity).slice(0, limit);
  }

  async getTotalPlayers(): Promise<number> {
    const all = await this.withStore<Player[]>("readonly", "getAll", []);
    return all.length;
  }

  async removeInactivePlayers(olderThanMs: number): Promise<number> {
    const all = await this.withStore<Player[]>("readonly", "getAll", []);
    const cutoff = Date.now() - olderThanMs;
    const toRemove = all.filter((p) => p.lastActivity < cutoff);
    for (const p of toRemove) {
      await this.withStore("readwrite", "delete", [p.authKey]);
    }
    return toRemove.length;
  }
}

// ---------------------------------------------------------------------------
// MongoDB adapter — plain Node driver, no page.evaluate needed.
// ---------------------------------------------------------------------------

export class MongoAdapter implements PlayerStore {
  private collection: Collection<Player>;

  private constructor(collection: Collection<Player>) {
    this.collection = collection;
  }

  static async connect(uri: string, dbName = "haxball", collectionName = "players") {
    const client = new MongoClient(uri);
    await client.connect();
    const collection = client.db(dbName).collection<Player>(collectionName);
    await collection.createIndex({ authKey: 1 }, { unique: true });
    return new MongoAdapter(collection);
  }

  async getPlayer(authKey: string): Promise<Player | null> {
    return this.collection.findOne({ authKey });
  }

  async getPlayerByName(name: string): Promise<Player | null> {
    return this.collection.findOne({ name });
  }

  async createOrUpdatePlayer(player: Player): Promise<void> {
    await this.collection.updateOne(
      { authKey: player.authKey },
      { $set: player },
      { upsert: true }
    );
  }

  async batchUpdatePlayers(players: Player[]): Promise<void> {
    if (players.length === 0) return;
    const ops = players.map((player) => ({
      updateOne: {
        filter: { authKey: player.authKey },
        update: { $set: player },
        upsert: true,
      },
    }));
    await this.collection.bulkWrite(ops);
  }

  async getTopEloPlayers(limit: number): Promise<Player[]> {
    return this.collection.find().sort({ elo: -1 }).limit(limit).toArray();
  }

  async getOldestPlayers(limit: number): Promise<Player[]> {
    return this.collection.find().sort({ lastActivity: 1 }).limit(limit).toArray();
  }

  async getTotalPlayers(): Promise<number> {
    return this.collection.countDocuments();
  }

  async removeInactivePlayers(olderThanMs: number): Promise<number> {
    const cutoff = Date.now() - olderThanMs;
    const result = await this.collection.deleteMany({ lastActivity: { $lt: cutoff } });
    return result.deletedCount ?? 0;
  }
}

// ---------------------------------------------------------------------------
// Usage: pick a backend once, use util.dbUtil.* everywhere else unchanged.
// ---------------------------------------------------------------------------
//
//   const store: PlayerStore = process.env.DB === "mongo"
//     ? await MongoAdapter.connect(process.env.MONGO_URI!)
//     : new IndexedDBAdapter(page);
//
//   export const dbUtil = store; // same call sites as before