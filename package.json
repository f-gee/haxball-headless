{
    "name": "haxball_headless",
    "version": "9.2.11",
    "description": "Haxball headless bot",
    "main": "dist/main.js",
    "scripts": {
        "bundle": "esbuild src/main.ts --bundle --platform=browser --format=iife --target=es2020 --outfile=dist/bundle.js",
        "build": "npm run typecheck && node build.js",
        "typecheck": "tsc --noEmit",
        "start": "node dist/main.js",
        "dev": "npm run build && concurrently \"node ui/server.js\" \"node db_api/server.js\""
    },
    "devDependencies": {
        "concurrently": "^10.0.4",
        "dotenv": "^17.4.2",
        "esbuild": "^0.28.1",
        "typescript": "^5.5.0"
    },
    "dependencies": {
        "express": "^5.2.1",
        "express-session": "^1.19.0",
        "haxball.js": "^4.0.3",
        "pug": "^3.0.4",
        "puppeteer": "^25.4.0"
    }
}