# Dependencies
node_modules/

# Build output
dist/

# TypeScript incremental build info
*.tsbuildinfo

# Source maps (generated, not source)
*.js.map

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Environment variables / secrets
.env
.env.local
.env.*.local

# Editor/OS junk
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# npm/yarn package manager files (keep lockfile, ignore cache)
.npm/
.yarn/cache/
.yarn/install-state.gz
