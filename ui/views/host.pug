doctype html
html
  head
    meta(charset="UTF-8")
    link(rel="stylesheet" href="/app.css")
  body
    h3 Host Haxball Room

    form(action="/host" method="POST")
      label
        input(type="radio" name="mode" value="puppeteer" checked)
        |  Puppeteer
      label
        input(type="radio" name="mode" value="haxballjs")
        |  haxball.js

      fieldset.env-switch
        legend Environment
        label
          input(type="radio" name="environment" value="development" checked)
          |  Development
        p.env-hint Less efficient, but lets you hot-swap functions on the fly while the room is running.

        label
          input(type="radio" name="environment" value="production")
          |  Production
        p.env-hint More efficient, but code is locked in — no live edits once hosted.

      input#tokenInput(type="text" name="token" placeholder="Room token" required)
      a(href="https://www.haxball.com/headlesstoken" target="_blank" rel="noopener") Get token
      button(type="submit") Host

      script(src="/host.js")